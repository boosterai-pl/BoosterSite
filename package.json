{
  "name": "booster-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- next dev",
    "build": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- next build",
    "start": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- node --import tsx scripts/seed.ts",
    "migrate:mdx": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- node --import tsx scripts/migrate-mdx.ts",
    "db:migrate": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- payload migrate",
    "db:migrate:create": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- payload migrate:create",
    "db:migrate:status": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- payload migrate:status",
    "db:migrate:fresh": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- payload migrate:fresh",
    "translate": "dotenvx run -f .env.local --ignore=MISSING_ENV_FILE -- node --import tsx scripts/translate.ts",
    "env:encrypt": "dotenvx encrypt -f .env.production",
    "env:decrypt": "dotenvx decrypt -f .env.production",
    "env:keypair": "dotenvx keypair -f .env.production",
    "opencode": "dotenvx run -f .env.local -f .env.production --overload --ignore=MISSING_ENV_FILE -- opencode"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/plugin-mcp": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-vercel-blob": "^3.84.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "gray-matter": "^4.0.3",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "payload": "^3.84.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.0",
    "@types/node": "20.14.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "5.5.3"
  },
  "overrides": {
    "@next/env": "16.2.6"
  }
}
