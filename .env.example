# Copy to .env.local for local development. Nothing here is required to build:
# `npm run build` works with no env vars set.

# Google Analytics 4 Measurement ID. Analytics loads only when this is set
# and the visitor accepts cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Vercel API token for checking deployments from the terminal
# (see .opencode/skills/deploying-boostersite/SKILL.md).
VERCEL_TOKEN=
